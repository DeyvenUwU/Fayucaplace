# Configuración de producción para Fayucaplace
# Copia este archivo a .env.production y configura tus valores

# Django Settings
DEBUG=False
DJANGO_SECRET_KEY=your-secret-key-here-change-this
ALLOWED_HOSTS=localhost,127.0.0.1,.ngrok-free.app,.ngrok.io

# Ngrok URL (se actualiza automáticamente con el script)
NGROK_URL=https://your-ngrok-url.ngrok-free.app

# Gunicorn Settings
GUNICORN_BIND=0.0.0.0:8000
GUNICORN_WORKERS=4
GUNICORN_LOG_LEVEL=info

# Database (si usas PostgreSQL en el futuro)
# DATABASE_URL=postgresql://user:password@localhost/dbname

# Email Settings (opcional)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
