# Ejemplo de variables de entorno para producción
# Copiar a .env y ajustar valores

# Seguridad
DJANGO_SECRET_KEY=genera-una-clave-larga-y-aleatoria-aqui-minimo-50-caracteres
DEBUG=False

# Hosts permitidos (separar por comas)
ALLOWED_HOSTS=tu-dominio.com,www.tu-dominio.com

# CSRF trusted origins (separar por comas)
CSRF_TRUSTED_ORIGINS=https://tu-dominio.com,https://www.tu-dominio.com

# Base de datos PostgreSQL
DATABASE_URL=postgres://usuario:contraseña@localhost:5432/fayucaplace
DB_PASSWORD=contraseña-segura-postgres

# Opcional: configuración adicional
# SENTRY_DSN=https://...  # Para monitoreo de errores
# REDIS_URL=redis://localhost:6379/0  # Para cache
